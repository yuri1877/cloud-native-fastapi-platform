
# Tracing (OpenTelemetry). Spans are always created so trace IDs appear in logs; set the
# collector's base URL to also export them (OTLP over HTTP). Local example: a Jaeger
# all-in-one container listening on 4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TRACING_SAMPLE_RATIO=1.0
# Continue a trace from an inbound traceparent header (only behind a trusted gateway).
# TRACING_TRUST_INBOUND_CONTEXT=false

# Docker Compose (docker-compose.yml reads this file for its ${...} values).
# UV_VERSION: required; the version printed by `uv --version` (the uv that wrote uv.lock).
# POSTGRES_PASSWORD: required; keep it URL-safe, because it is embedded in DATABASE_URL.
# Never commit your .env.
# UV_VERSION=
# POSTGRES_PASSWORD=
# POSTGRES_USER=
# POSTGRES_DB=
# POSTGRES_PORT=
# API_PORT=
# PYTHON_VERSION=
