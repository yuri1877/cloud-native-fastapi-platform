# Copy to .env for local development. Placeholders only - never commit real secrets.
APP_NAME=cloud-native-fastapi-platform
APP_ENV=dev
LOG_LEVEL=INFO
AWS_REGION=eu-west-2

# Database (must use the postgresql+asyncpg:// scheme). Required in staging/prod.
DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Integration tests only. The database name MUST end in "_test" (tests create/drop tables).
# TEST_DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/app_test
